# Copy this file to `.github/workflows/audit-publish.yml` in any repo you
# want to publish a code-audit catalog from. The reusable workflow it
# invokes lives in jakebromberg/code-audit-pipeline; one tag bump there
# advances every consumer.
#
# Prerequisites (one-time per repo, per org):
#   - The org's Cloudflare R2 bucket exists (or any S3-compatible bucket).
#   - OIDC trust is set up between GitHub Actions and the bucket — see
#     docs/audit-publish-setup.md in code-audit-pipeline for the policy.
#   - The role/keys are wired into this repo's secrets.

name: Publish code-audit catalog

on:
  push:
    branches: [main]
    # Skip publishes for changes that don't move the catalog: docs,
    # GitHub config, ignore files. Tune per repo; the cost of a wasted
    # run is a duplicate timestamped prefix in R2 with identical
    # catalogs to the prior run.
    paths-ignore:
      - '**/*.md'
      - 'docs/**'
      - '.github/**'
      - '.gitignore'
      - 'LICENSE*'
  schedule:
    # Nightly catch-up in case a push misses publication. **Pick a
    # randomized minute and hour per repo** — copying this verbatim
    # across N consumers schedules them all at the same instant,
    # racing index.json writes and contending for R2 rate limits.
    # `date -u +%M` once and substitute, or just pick anything ≠ 17:07.
    - cron: '17 7 * * *'
  workflow_dispatch:

# `id-token: write` is required for OIDC. Static-key callers may set
# this to `none` — but note that the reusable workflow's own
# permissions block declares `id-token: write` as an upper bound; the
# caller (this file) decides what to actually grant.
permissions:
  contents: read
  id-token: write

jobs:
  publish:
    uses: jakebromberg/code-audit-pipeline/.github/workflows/publish-catalog-reusable.yml@v1
    with:
      # Point these at your org's R2 (or S3) bucket. Bucket names must be
      # unique per Cloudflare account; endpoint is the account-scoped URL
      # printed in the R2 dashboard under "S3 API".
      bucket-name: wxyc-code-audit
      bucket-endpoint: https://<account-id>.r2.cloudflarestorage.com
      # Recommended: assume an OIDC-trusted role rather than passing
      # static keys. Comment out role-to-assume + uncomment the secrets
      # block below to fall back to keys.
      role-to-assume: arn:aws:iam::000000000000:role/wxyc-code-audit-publisher
      # bucket-region: us-east-1   # ← uncomment + set if publishing to real S3 (not R2)
    secrets: inherit
    # When using static keys instead of OIDC, drop the `role-to-assume`
    # line above and uncomment the explicit forwarding below. Note:
    # `secrets: inherit` works ONLY because the reusable's secret-input
    # names match real repo-secret names (alphanumerics + underscores).
    # secrets:
    #   R2_ACCESS_KEY_ID:     ${{ secrets.R2_ACCESS_KEY_ID }}
    #   R2_SECRET_ACCESS_KEY: ${{ secrets.R2_SECRET_ACCESS_KEY }}
